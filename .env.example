# ── DeepSeek API（必填）─────────────────
DEEPSEEK_API_KEY=sk-your-deepseek-api-key
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
MODEL=deepseek-chat

# ── 博查搜索 API（可选，不填则仅用 DDG + DeepSeek）──
BOCHA_API_KEY=

# ── 工作流配置 ──────────────────────────
MAX_ITERATIONS=2

# ── 记忆系统 ────────────────────────────
ENABLE_MEMORY=true
DB_PATH=data/memory.db

# ── 服务配置 ────────────────────────────
HOST=0.0.0.0
PORT=8764

# ── 频率限制（按用户，重启清零）─────────
RATE_LIMIT_PER_HOUR=4
RATE_LIMIT_CONCURRENCY=3
